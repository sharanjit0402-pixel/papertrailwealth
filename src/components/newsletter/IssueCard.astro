---
const { issue } = Astro.props;
const d = issue.data;
const top = d.scoreboard.slice(0, 3);
---
<a class="card nl-card" href={`/newsletter/${issue.id}/`}>
  <div class="th nl-th">
    <div class="nl-th-top"><span>ISSUE #{d.issue}</span><span>{d.week}</span></div>
    <div class="nl-th-rows">{top.map((s) => <div class="nl-th-row"><span>{s.name}</span><b class={s.up ? 'up' : 'dn'}>{s.change}</b></div>)}</div>
  </div>
  <div class="b">
    <div class="tag">Weekly Investing Newsletter</div>
    <h3>{d.title}</h3>
    <p>{d.description}</p>
  </div>
</a>
<style>
  .nl-th{background:linear-gradient(160deg,#0B3D26,#1F7A4D);color:#fff;display:flex;flex-direction:column;align-items:stretch;justify-content:center;padding:18px 22px;gap:12px;font-size:16px;letter-spacing:0}
  .nl-th-top{display:flex;justify-content:space-between;font-size:12px;font-weight:800;letter-spacing:2px;color:#A7F3C9}
  .nl-th-rows{display:flex;flex-direction:column;gap:8px}
  .nl-th-row{display:flex;justify-content:space-between;align-items:center;background:rgba(255,255,255,.1);border-radius:10px;padding:8px 12px;font-size:16px;font-weight:700}
  .nl-th-row b.dn{color:#FFB4AE}.nl-th-row b.up{color:#A7F3C9}
</style>
