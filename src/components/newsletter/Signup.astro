---
// Weekly Investing Newsletter sign-up box.
// Saves the email in Supabase (table: newsletter_subscribers). Each Saturday we
// email subscribers a short teaser with a link to read the full issue on the site.
interface Props { variant?: 'card' | 'wide'; source?: string; }
const { variant = 'card', source = 'site' } = Astro.props;
---
<aside class={`nl-box nl-${variant}`} data-source={source}>
  <div class="nl-tag">Free · Every Saturday</div>
  <h3>The Weekly Investing Newsletter</h3>
  <p>Everything that moved U.S. markets this week: the Nasdaq, the Dow, the Fed, Washington and big company news, explained in plain English. We'll email you when each new issue is out.</p>
  <form class="nl-form" novalidate>
    <input type="email" name="email" placeholder="Your email address" autocomplete="email" required aria-label="Email address" />
    <button class="btn nl-btn" type="submit">Get the newsletter</button>
  </form>
  <div class="nl-msg" role="status"></div>
  <div class="nl-small">One email a week. No spam. Unsubscribe anytime.</div>
</aside>
<script>
  import { SUPABASE } from '../../site';
  document.querySelectorAll<HTMLElement>('.nl-box').forEach((box) => {
    const form = box.querySelector('form')!;
    const msg = box.querySelector<HTMLElement>('.nl-msg')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim().toLowerCase();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { msg.textContent = 'Please enter a valid email address.'; msg.className = 'nl-msg err'; return; }
      const btn = form.querySelector('button')!; btn.disabled = true; btn.textContent = 'Signing you up…';
      try {
        const res = await fetch(`${SUPABASE.url}/rest/v1/newsletter_subscribers`, {
          method: 'POST',
          headers: { apikey: SUPABASE.anonKey, Authorization: `Bearer ${SUPABASE.anonKey}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify({ email, source: box.dataset.source || 'site' }),
        });
        // 409 = already subscribed, which is fine
        if (!res.ok && res.status !== 409) throw new Error(String(res.status));
        form.style.display = 'none';
        msg.innerHTML = "<strong>You're in!</strong> Watch your inbox on Saturday morning for the next issue.";
        msg.className = 'nl-msg ok';
      } catch {
        btn.disabled = false; btn.textContent = 'Get the newsletter';
        msg.textContent = 'Something went wrong. Please try again in a minute.'; msg.className = 'nl-msg err';
      }
    });
  });
</script>
<style>
  .nl-box{background:linear-gradient(160deg,#0B3D26,#145C3A);color:#fff;border-radius:22px;padding:30px 28px;margin:34px 0}
  .nl-tag{display:inline-block;background:rgba(255,255,255,.14);color:#A7F3C9;font-weight:800;font-size:12px;letter-spacing:2px;text-transform:uppercase;padding:6px 12px;border-radius:999px}
  .nl-box h3{font-size:26px;letter-spacing:-.6px;margin:14px 0 8px;color:#fff}
  .nl-box p{color:#D7EBDF;font-size:16px;line-height:1.55;margin:0 0 18px}
  .nl-form{display:flex;gap:10px;flex-wrap:wrap}
  .nl-form input{flex:1 1 240px;min-width:0;border:0;border-radius:12px;padding:14px 16px;font-size:16px;font-family:inherit}
  .nl-btn{background:#34A871;color:#fff;border:0;border-radius:12px;padding:14px 20px;font-weight:800;font-size:16px;cursor:pointer}
  .nl-btn:disabled{opacity:.7}
  .nl-msg{margin-top:12px;font-size:15px;min-height:1px}
  .nl-msg.ok{color:#A7F3C9;font-size:17px}.nl-msg.err{color:#FECACA}
  .nl-small{margin-top:10px;font-size:13px;color:#9FC8B0}
  .nl-wide{padding:38px 36px}
</style>
