---
// Sign-in / account panel shown on every challenge page.
---
<div class="auth" id="authbox">
  <div id="auth-out">
    <h3>Save your progress &amp; get reminders</h3>
    <p id="auth-mode-note">Your progress is saved on this device. Add your email to keep it safe on every device and get streak reminders. No password: we email you a one-tap login link.</p>
    <form id="auth-form">
      <input type="text" id="auth-name" placeholder="First name" autocomplete="given-name" required />
      <input type="email" id="auth-email" placeholder="you@email.com" autocomplete="email" required />
      <button class="btn btn-green" type="submit">Email me a link</button>
    </form>
    <label class="chk"><input type="checkbox" id="auth-optin" checked /> Send me reminders and progress emails from The Paper Trail. Unsubscribe anytime.</label>
    <p id="auth-msg" style="margin-top:10px;font-weight:600"></p>
  </div>
  <div id="auth-in" class="hidden">
    <h3>✓ Signed in as <span id="auth-who"></span></h3>
    <p>Your progress is saved to your account. <a href="#" id="auth-signout" style="color:var(--g);font-weight:600">Sign out</a></p>
  </div>
</div>
<div class="toast" id="toast"></div>
<div class="gate hidden" id="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
  <div class="gate-card">
    <div style="font-size:40px;line-height:1" id="gate-emoji">🔥</div>
    <h3 id="gate-title">Don't lose your progress</h3>
    <p id="gate-sub">Add your email and we'll save your challenge to your account and remind you before your streak breaks. No password, no spam.</p>
    <form id="gate-form">
      <input type="text" id="gate-name" placeholder="First name" autocomplete="given-name" required />
      <input type="email" id="gate-email" placeholder="you@email.com" autocomplete="email" required />
      <label class="chk"><input type="checkbox" id="gate-optin" checked /> Send me reminders and progress emails. Unsubscribe anytime.</label>
      <button class="btn btn-green btn-big" type="submit" style="width:100%">Save my progress</button>
    </form>
    <p id="gate-msg" style="margin-top:10px;font-weight:600"></p>
    <button type="button" id="gate-skip" class="gate-skip">Continue without saving</button>
  </div>
</div>
<script>
  import { backendReady, ready, onUser, signIn, signOut } from '../../scripts/challenges-store';
  const $ = (id: string) => document.getElementById(id)!;
  if (!backendReady) {
    $('auth-form').classList.add('hidden');
    document.querySelector('#authbox .chk')!.classList.add('hidden');
    $('auth-mode-note').textContent = 'Your progress is saved on this device. Accounts with email reminders are coming very soon.';
  } else {
    onUser((u) => {
      $('auth-out').classList.toggle('hidden', !!u);
      $('auth-in').classList.toggle('hidden', !u);
      if (u) $('auth-who').textContent = (u.user_metadata?.name ? u.user_metadata.name + ' · ' : '') + (u.email ?? '');
    });
    $('auth-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = $('auth-msg');
      msg.textContent = 'Sending…';
      try {
        await signIn(($('auth-email') as HTMLInputElement).value.trim(), ($('auth-name') as HTMLInputElement).value.trim(), ($('auth-optin') as HTMLInputElement).checked);
        msg.innerHTML = '📬 Check your inbox for a login link from hello@papertrailwealth.com.';
      } catch (err: any) { msg.textContent = 'Something went wrong: ' + (err?.message ?? 'please try again.'); }
    });
    $('auth-signout').addEventListener('click', async (e) => { e.preventDefault(); await signOut(); location.reload(); });
  }
  // Email step: pages call window.ptwAskEmail(reason) before starting a
  // challenge and after the first check-in. Resolves when the visitor
  // submits or skips; never blocks someone who is signed in.
  let gateResolve: (() => void) | null = null;
  const closeGate = () => { $('gate').classList.add('hidden'); gateResolve?.(); gateResolve = null; };
  (window as any).ptwAskEmail = async (reason: 'start' | 'first') => {
    if (!backendReady) return;
    const u = await ready(); if (u) return;
    const skips = Number(localStorage.getItem('ptw:email-skips') || 0);
    if (reason === 'first' && skips >= 2) return;
    if (reason === 'start' && skips >= 3) return;
    if (sessionStorage.getItem('ptw:email-sent')) return;
    if (reason === 'first') {
      $('gate-emoji').textContent = '🎉'; $('gate-title').textContent = 'Day 1 done! Want a reminder tomorrow?';
      $('gate-sub').textContent = "Your progress is only saved on this device right now. Add your email to keep it safe and we'll nudge you before your streak runs out.";
    }
    $('gate').classList.remove('hidden');
    ($('gate-name') as HTMLInputElement).focus();
    return new Promise<void>((res) => { gateResolve = res; });
  };
  $('gate-skip').addEventListener('click', () => { localStorage.setItem('ptw:email-skips', String(Number(localStorage.getItem('ptw:email-skips') || 0) + 1)); closeGate(); });
  $('gate-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('gate-msg'); msg.textContent = 'Sending…';
    try {
      await signIn(($('gate-email') as HTMLInputElement).value.trim(), ($('gate-name') as HTMLInputElement).value.trim(), ($('gate-optin') as HTMLInputElement).checked);
      sessionStorage.setItem('ptw:email-sent', '1');
      msg.textContent = '📬 Check your inbox and tap the link from hello@papertrailwealth.com to finish saving.';
      setTimeout(closeGate, 2500);
    } catch (err: any) { msg.textContent = 'Something went wrong: ' + (err?.message ?? 'please try again.'); }
  });
  ready();
</script>
