---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import ChallengeCTA from '../../components/challenges/ChallengeCTA.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../site';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const related = (await getCollection('posts')).filter((p) => p.id !== post.id).slice(0, 3);
const ogImage = post.data.image?.endsWith('.svg') ? post.data.image.replace('/images/', '/og/').replace(/\.svg$/, '.png') : post.data.image;
const schema = { '@context': 'https://schema.org', '@type': 'Article', headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), author: { '@type': 'Person', name: 'Sharon' }, publisher: { '@type': 'Organization', name: 'The Paper Trail' } };
---
<Base title={post.data.title} description={post.data.description} image={ogImage}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <article class="article">
    <div class="crumbs"><a href="/">Home</a> / <a href={`/category/${slugify(post.data.category)}/`}>{post.data.category}</a></div>
    <h1>{post.data.title}</h1>
    {post.data.image && <img class="hero-img" src={post.data.image} alt={post.data.imageAlt ?? post.data.title} width="1600" height="900" />}
    <div class="meta">By Sharon · {date}</div>
    <div class="prose"><Content /></div>
    {post.data.challenge && <ChallengeCTA challenge={post.data.challenge} />}
    <p class="note"><strong>About the author:</strong> Sharon writes The Paper Trail's plain-English money guides. <br/><br/>This article is general education, not personal financial advice. Everyone's situation is different. For decisions about your own money, consider speaking with a qualified professional.</p>
  </article>
  <section class="container"><h2 class="section-title">Keep reading</h2><div class="grid">{related.map((p) => <PostCard post={p} />)}</div></section>
</Base>
