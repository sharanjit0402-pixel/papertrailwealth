---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="page" style="text-align:center;padding:120px 24px">
    <h1>This page went off the trail.</h1>
    <p class="muted" style="font-size:19px;margin-top:14px">The page you're looking for doesn't exist or has moved.</p>
    <a class="btn btn-green" href="/" style="margin-top:28px">Back to the homepage</a>
  </section>
</Base>
